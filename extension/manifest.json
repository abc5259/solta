{
  "manifest_version": 3,
  "name": "Baekjoon Solve Timer",
  "version": "0.1.0",
  "description": "백준 문제 풀이 시간 자동 측정 및 완료시 알림 표시",
  "permissions": [
    "storage",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.acmicpc.net/*",
    "https://solved.ac/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.acmicpc.net/problem/*"
      ],
      "js": ["content_problem.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.acmicpc.net/status*"
      ],
      "js": ["content_status.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
} 